# ---------------------------------------------------------------------------
# SikHal environment template
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase (database, auth, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LLM provider for the agent orchestration layer
LLM_API_KEY=
LLM_MODEL=

# Payments (Malaysian gateway — e.g. Billplz / ToyyibPay / Stripe MY)
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_CALLBACK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
